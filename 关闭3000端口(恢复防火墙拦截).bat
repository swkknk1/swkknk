@echo off
chcp 65001 >nul
cd /d "%~dp0"

echo ======================================================
echo   正在关闭 3000 端口并恢复防火墙拦截...
echo ======================================================
echo.

netsh advfirewall firewall delete rule name=Node_Port_3000 >nul 2>&1

if %errorlevel% equ 0 (
    echo.
    echo ======================================================
    echo   ✅【已成功关闭！】防火墙已恢复拦截
    echo ======================================================
    echo.
) else (
    echo.
    echo ======================================================
    echo   ⚠️【需要管理员权限】
    echo.
    echo   请在该文件上：
    echo   👉【点击鼠标右键】
    echo   👉 选择【以管理员身份运行】！
    echo ======================================================
    echo.
)

pause
